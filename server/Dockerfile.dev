FROM php:8.2-apache

WORKDIR /var/www

RUN a2enmod rewrite

RUN apt-get update \
  && apt-get install -y libzip-dev git wget unzip --no-install-recommends \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

RUN docker-php-ext-install pdo mysqli pdo_mysql zip

RUN wget https://getcomposer.org/download/2.8.3/composer.phar \
    && mv composer.phar /usr/bin/composer && chmod +x /usr/bin/composer

COPY api/ /var/www/api

# Create cache and log directories with proper permissions
RUN mkdir -p /var/www/api/var/cache /var/www/api/var/log \
    && chown -R www-data:www-data /var/www/api/var \
    && chmod -R 775 /var/www/api/var

COPY server/apache-dev.conf /etc/apache2/sites-enabled/000-default.conf

WORKDIR /var/www

# Installer les dépendances et fixer les permissions au runtime
CMD ["sh", "-c", "composer install -d /var/www/api --no-interaction && mkdir -p /var/www/api/var/cache /var/www/api/var/log && chown -R www-data:www-data /var/www/api/var && chmod -R 775 /var/www/api/var && apache2-foreground"]

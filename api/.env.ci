###> symfony/framework-bundle ###
APP_ENV=test
APP_SECRET=test_secret_for_ci
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Dummy values for CI - database is not needed for cache:clear
DATABASE_URL="mysql://root:password@localhost/test?serverVersion=10.11.8&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=password
###< lexik/jwt-authentication-bundle ###

###> Variables dummy pour CI ###
MYSQL_SERVER=localhost
MYSQL_DATABASE=test
MYSQL_VERSION=10.11.8
###< Variables dummy pour CI ###

